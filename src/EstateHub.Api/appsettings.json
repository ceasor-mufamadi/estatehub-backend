{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5268",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://localhost:5269",
        "Protocols": "Http2"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "estatehub",
    "Audience": "estatehub",
    "AccessTokenMinutes": 15,
    "SigningKeyPem": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Streaming": {
    "HeartbeatSeconds": 30,
    "MaxStreamsPerUser": 5
  },
  "RateLimits": {
    "SignedInPerMinute": 300,
    "AnonymousPerMinute": 20
  },
  "ReverseProxy": {
    "TrustedNetworks": []
  },
  "CronJobs": {
    "DummyJob": {
      "Enabled": false,
      "Cron": "*/5 * * * *",
      "RetryCount": 0,
      "RetryDelaySeconds": 30
    },
    "SigningKeyRotationJob": {
      "Enabled": true,
      "Cron": "0 2 * * *",
      "RetryCount": 3,
      "RetryDelaySeconds": 300
    },
    "AuthCleanupJob": {
      "Enabled": true,
      "Cron": "30 3 * * *",
      "RetryCount": 2,
      "RetryDelaySeconds": 300
    },
    "ImportInvitationsJob": {
      "Enabled": true,
      "Cron": "*/10 * * * *",
      "RetryCount": 0,
      "RetryDelaySeconds": 60
    },
    "AccountSyncJob": {
      "Enabled": true,
      "Cron": "15 0 * * *",
      "RetryCount": 2,
      "RetryDelaySeconds": 300
    },
    "LevyBillingDraftJob": {
      "Enabled": true,
      "Cron": "0 2 * * *",
      "RetryCount": 2,
      "RetryDelaySeconds": 300
    }
  }
}
